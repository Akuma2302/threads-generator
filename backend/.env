# Hermes copywriting agent runs on OpenRouter (OpenAI-compatible API).
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Free-tier model by default. Swap to a paid model any time by changing this,
# e.g. nousresearch/hermes-4-70b for the real Hermes 4 model (paid, cheap).
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Comma-separated backup models tried in order if the primary model's
# provider errors out (free models on OpenRouter have flaky uptime).
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,z-ai/glm-4.5-air:free,nvidia/nemotron-3-super-120b-a12b:free

# Used in OpenRouter's required attribution headers (HTTP-Referer / X-Title).
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Threads Generator

# Port for the Express server
PORT=5000

# Comma separated list of allowed origins for CORS (your Netlify frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# Rate limit: max requests per window per IP
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=900000
